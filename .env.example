# Sao chép file này thành .env.local rồi điền giá trị từ `supabase start` (môi trường local)
# hoặc từ Project Settings > API trên Supabase Cloud (môi trường thật).

# URL API của Supabase (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Anon public key, an toàn khi dùng ở browser (đã bị giới hạn bởi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: CHỈ dùng ở server (ví dụ script tạo tài khoản thủ công), không bao giờ
# đưa vào mã chạy ở browser hoặc commit vào git.
SUPABASE_SERVICE_ROLE_KEY=

# Secret tùy ý để bảo vệ route /api/cron/snapshot-stock — cron bên ngoài (ví dụ
# GitHub Actions, cron-job.org) gọi hằng đêm kèm header "x-cron-secret: <giá trị này>".
CRON_SECRET=
